# Copy to .env and edit as needed. All values are optional (defaults shown).

# --- Summarization model ---
# For a faster laptop demo, switch to the distilled model:
# SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
SUMMARIZER_MODEL=facebook/bart-large-cnn
SUMMARY_MIN_LENGTH=40
SUMMARY_MAX_LENGTH=180

# Load the model at startup instead of on first request (slower boot).
# WARMUP_MODEL=1

# --- Entities ---
SPACY_MODEL=en_core_web_sm
MAX_ENTITIES=6

# --- Wikipedia ---
WIKIPEDIA_LANG=en
WIKIPEDIA_TIMEOUT=8

# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./submissions.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/summarizer

# --- CORS: comma-separated is NOT parsed; use JSON list form if overriding ---
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.example.com"]
