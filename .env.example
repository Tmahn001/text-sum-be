# Copy to .env and edit as needed. All values are optional (defaults shown).

# --- Summarization model ---
# For a faster laptop demo, switch to the distilled model:
# SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
SUMMARIZER_MODEL=facebook/bart-large-cnn
SUMMARY_MIN_LENGTH=40
SUMMARY_MAX_LENGTH=180

# Load the model at startup instead of on first request (slower boot).
# WARMUP_MODEL=1

# --- Verification (sentence linking + faithfulness flagging) ---
# Both models load on first /api/verify call, not at startup: together they add
# ~800MB on top of BART, which does not fit a 2GB server. Set VERIFY_WARMUP=1
# to load them at boot where there is RAM to spare.
# VERIFY_WARMUP=1
VERIFY_EMBED_MODEL=all-MiniLM-L6-v2
VERIFY_NLI_MODEL=cross-encoder/nli-deberta-v3-base
# Half the memory, lower accuracy — for small servers:
# VERIFY_NLI_MODEL=typeform/distilbert-base-uncased-mnli
VERIFY_TOP_K=2
VERIFY_THRESHOLD=0.5
VERIFY_MAX_SOURCE_SENTENCES=2000
# Evaluation data for Chapter 4; set to "" to disable.
VERIFICATION_LOG_PATH=verification_log.jsonl

# --- Entities ---
SPACY_MODEL=en_core_web_sm
MAX_ENTITIES=6

# --- Wikipedia ---
WIKIPEDIA_LANG=en
WIKIPEDIA_TIMEOUT=8

# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./submissions.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/summarizer

# --- CORS: comma-separated is NOT parsed; use JSON list form if overriding ---
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.example.com"]
